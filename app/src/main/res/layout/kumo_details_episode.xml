<?xml version="1.0" encoding="utf-8"?>
<!-- Nuvio EpisodeHorizontalCard (phone tier): 296x184dp, 12dp radius,
     full-bleed art + bottom scrim, badge/title/overview/meta overlay,
     4dp progress bar pinned to bottom edge. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="330dp"
    android:layout_height="202dp"
    android:layout_marginEnd="12dp"
    android:foreground="@drawable/outline_drawable"
    app:cardBackgroundColor="#14141C"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/kumoEpisodeThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:src="@drawable/example_poster" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/kumo_hero_gradient_vertical" />

        <TextView
            android:id="@+id/kumoEpisodeWatched"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="@drawable/kumo_badge_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="✓"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="@font/google_sans"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/kumoEpisodeNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/kumo_badge_bg"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/google_sans"
                    tools:text="EPISODE 1" />

                <TextView
                    android:id="@+id/kumoEpisodeFiller"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/kumo_badge_bg"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="FILLER"
                    android:textColor="#9AA0A6"
                    android:textSize="9sp"
                    android:fontFamily="@font/google_sans"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/kumoEpisodeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/google_sans"
                android:maxLines="1"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:focusable="false"
                tools:text="A World Without..." />

            <TextView
                android:id="@+id/kumoEpisodeDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#DBFFFFFF"
                android:textSize="11sp"
                android:fontFamily="@font/google_sans"
                android:lineSpacingExtra="4dp"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Rudeus begins his new life as an infant..." />

            <LinearLayout
                android:id="@+id/kumoEpisodeMetaRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/kumoEpisodeRuntime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#C7FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="@font/google_sans"
                    android:maxLines="1"
                    android:visibility="gone"
                    tools:text="24m"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/kumoEpisodeImdbBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/kumo_imdb_badge"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="IMDb"
                    android:textColor="#14141C"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/google_sans"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/kumoEpisodeMeta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:textColor="#F5C518"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/google_sans"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone"
                    tools:text="8.4"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/kumoEpisodeDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#C7FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="@font/google_sans"
                    android:maxLines="1"
                    tools:text="Jan 12, 2021" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/kumoEpisodeProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="8dp"
            android:max="100"
            android:progressTint="#7A5CFA"
            android:progressBackgroundTint="#38FFFFFF"
            android:visibility="gone"
            tools:visibility="visible"
            tools:progress="40" />
    </FrameLayout>
</androidx.cardview.widget.CardView>
