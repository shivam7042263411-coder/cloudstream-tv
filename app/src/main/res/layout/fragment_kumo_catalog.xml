<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080A0F"
    tools:context=".ui.kumo.catalog.KumoCatalogFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/kumoCatalogBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/go_back"
                app:srcCompat="@drawable/ic_baseline_arrow_back_24"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Browse"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/google_sans" />

            <ProgressBar
                android:id="@+id/kumoCatalogResolving"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:indeterminateTint="#7A5CFA"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/kumoCatalogAdd"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/duplicate_add"
                app:srcCompat="@drawable/ic_baseline_add_24"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#0F0F14" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/kumoCatalogRows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            tools:listitem="@layout/kumo_catalog_row" />

        <LinearLayout
            android:id="@+id/kumoCatalogEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No catalog addons yet"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/google_sans"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Add a Stremio catalog addon URL to browse anime rows."
                android:textColor="#9AA0A6"
                android:textSize="13sp"
                android:fontFamily="@font/google_sans"
                android:gravity="center" />

            <Button
                android:id="@+id/kumoCatalogEmptyAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/kumo_play_button"
                android:text="Add addon"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/google_sans"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/kumoCatalogLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="#7A5CFA"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
